<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Abdurasheed Device World</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#050b14;
    color:#fff;
}

header{
    position:sticky;
    top:0;
    z-index:100;
    background:rgba(5,11,20,.96);
    border-bottom:1px solid #1d3955;
    padding:18px 6%;
}

.nav{
    max-width:1250px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:21px;
    font-weight:900;
}

.logo span{
    color:#1683ff;
}

.nav a{
    color:#c9d8e8;
    text-decoration:none;
    margin-left:22px;
}

.hero{
    min-height:650px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:60px 18px;
    background:
      radial-gradient(circle at top,#12355c 0,#071321 42%,#050b14 75%);
}

.hero-content{
    width:100%;
    max-width:1000px;
}

.badge{
    display:inline-block;
    padding:8px 15px;
    border:1px solid #27699e;
    background:#09213a;
    border-radius:30px;
    color:#80c5ff;
    font-size:13px;
}

h1{
    font-size:clamp(42px,8vw,78px);
    margin:22px 0 15px;
    line-height:.98;
}

.hero p{
    max-width:720px;
    margin:auto;
    color:#a9bbcf;
    font-size:18px;
    line-height:1.6;
}

.search-area{
    max-width:850px;
    margin:35px auto 15px;
    display:flex;
    padding:7px;
    background:#0d1b2b;
    border:1px solid #315474;
    border-radius:17px;
}

.search-area input{
    flex:1;
    min-width:0;
    padding:16px;
    background:transparent;
    border:0;
    outline:0;
    color:#fff;
    font-size:17px;
}

.search-area button{
    background:#1683ff;
    color:#fff;
    border:0;
    border-radius:11px;
    padding:0 28px;
    font-weight:bold;
    cursor:pointer;
}

.quick{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:8px;
}

button{
    cursor:pointer;
}

.quick button,
.action button{
    color:#eaf4ff;
    background:#0c1d31;
    border:1px solid #294967;
    border-radius:10px;
    padding:11px 15px;
}

.quick button:hover,
.action button:hover{
    background:#1683ff;
}

.action{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:10px;
    margin-top:20px;
}

main{
    width:94%;
    max-width:1250px;
    margin:auto;
    padding:40px 0 80px;
}

.section-title{
    font-size:28px;
    margin-bottom:20px;
}

.categories{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    gap:16px;
}

.category{
    padding:28px 15px;
    text-align:center;
    border-radius:17px;
    background:#0b1929;
    border:1px solid #1e3a56;
    transition:.2s;
}

.category:hover{
    transform:translateY(-5px);
    border-color:#1683ff;
}

.category .icon{
    font-size:40px;
    margin-bottom:12px;
}

.feature{
    margin-top:45px;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:15px;
}

.feature-card{
    background:#0b1929;
    border:1px solid #1e3a56;
    border-radius:16px;
    padding:23px;
}

.feature-card h3{
    margin-bottom:10px;
}

.feature-card p{
    color:#98abc0;
    line-height:1.5;
}

.notice{
    margin-top:45px;
    padding:25px;
    border-radius:17px;
    background:#091a2c;
    border:1px solid #1e3a56;
    color:#afc1d4;
    line-height:1.7;
}

footer{
    text-align:center;
    padding:35px 15px;
    background:#030810;
    color:#71869d;
}

@media(max-width:650px){

    .nav a{
        display:none;
    }

    .search-area{
        flex-direction:column;
        gap:7px;
    }

    .search-area button{
        height:52px;
    }

    h1{
        font-size:45px;
    }
}
</style>
</head>

<body>

<header>
<div class="nav">

<div class="logo">
ABDURASHEED <span>DEVICE WORLD</span>
</div>

<div>
<a href="#categories">Devices</a>
<a href="#features">Features</a>
</div>

</div>
</header>


<section class="hero">

<div class="hero-content">

<span class="badge">
LIVE DEVICE SEARCH
</span>

<h1>
Find Any Device.
</h1>

<p>
Search phones, keypad phones, laptops, tablets,
smart TVs, watches and other technology.
</p>


<div class="search-area">

<input
id="deviceInput"
type="search"
placeholder="Search a device e.g. Samsung Galaxy A22"
>

<button onclick="webSearch()">
SEARCH
</button>

</div>


<div class="quick">

<button onclick="chooseDevice('Samsung Galaxy A22')">
Galaxy A22
</button>

<button onclick="chooseDevice('iPhone 6')">
iPhone 6
</button>

<button onclick="chooseDevice('Nokia 3310')">
Nokia 3310
</button>

<button onclick="chooseDevice('Tecno Camon 30')">
Tecno Camon 30
</button>

<button onclick="chooseDevice('Samsung Galaxy S26')">
Galaxy S26
</button>

</div>


<div class="action">

<button onclick="search('web')">
🌐 Web
</button>

<button onclick="search('images')">
🖼 Images
</button>

<button onclick="search('specs')">
📋 Specifications
</button>

<button onclick="search('price')">
💰 Price
</button>

<button onclick="search('reviews')">
⭐ Reviews
</button>

<button onclick="search('videos')">
▶ Videos
</button>

</div>

</div>

</section>


<main>

<section id="categories">

<h2 class="section-title">
Explore Devices
</h2>

<div class="categories">

<div class="category"
onclick="chooseDevice('smartphones')">

<div class="icon">📱</div>
<strong>Smartphones</strong>

</div>


<div class="category"
onclick="chooseDevice('keypad phones')">

<div class="icon">☎️</div>
<strong>Keypad Phones</strong>

</div>


<div class="category"
onclick="chooseDevice('laptops')">

<div class="icon">💻</div>
<strong>Laptops</strong>

</div>


<div class="category"
onclick="chooseDevice('tablets')">

<div class="icon">📲</div>
<strong>Tablets</strong>

</div>


<div class="category"
onclick="chooseDevice('smart TVs')">

<div class="icon">📺</div>
<strong>Smart TVs</strong>

</div>


<div class="category"
onclick="chooseDevice('smart watches')">

<div class="icon">⌚</div>
<strong>Smart Watches</strong>

</div>

</div>

</section>


<section id="features">

<h2 class="section-title" style="margin-top:50px">
What You Can Find
</h2>

<div class="feature">

<div class="feature-card">
<h3>📋 Specifications</h3>
<p>
Search for display, processor, RAM, storage,
battery, cameras, network support and more.
</p>
</div>


<div class="feature-card">
<h3>🖼 Device Pictures</h3>
<p>
Open image results for the device you search for.
</p>
</div>


<div class="feature-card">
<h3>💰 Prices</h3>
<p>
Search current web results for device prices.
</p>
</div>


<div class="feature-card">
<h3>⭐ Reviews</h3>
<p>
Find reviews and opinions about the device.
</p>
</div>

</div>

</section>


<div class="notice">

<strong>About Abdurasheed Device World</strong>

<br><br>

This website uses live web searches rather than pretending
that a small list contains every device in existence.

When you search for a device, the buttons can open web,
image, specification, price, review and video results.

<br><br>

<strong>Important:</strong>
The website itself is static, so it can be hosted online
without Cxxdroid running or your phone being switched on.

</div>

</main>


<footer>

ABDURASHEED DEVICE WORLD

<br><br>

© 2026 Abdurasheed Rajab

</footer>


<script>

const input = document.getElementById("deviceInput");


function getDevice(){

    const value = input.value.trim();

    if(value === ""){

        alert("Please enter a device name first.");

        return null;
    }

    return value;
}


function chooseDevice(name){

    input.value = name;

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}


function webSearch(){

    search("web");
}


function search(type){

    const device = getDevice();

    if(!device){
        return;
    }

    let query = device;
    let url = "";


    if(type === "web"){

        url =
        "https://www.google.com/search?q="
        + encodeURIComponent(query);

    }


    if(type === "images"){

        url =
        "https://www.google.com/search?tbm=isch&q="
        + encodeURIComponent(query);

    }


    if(type === "specs"){

        query += " full specifications";

        url =
        "https://www.google.com/search?q="
        + encodeURIComponent(query);

    }


    if(type === "price"){

        query += " price";

        url =
        "https://www.google.com/search?q="
        + encodeURIComponent(query);

    }


    if(type === "reviews"){

        query += " review";

        url =
        "https://www.google.com/search?q="
        + encodeURIComponent(query);

    }


    if(type === "videos"){

        url =
        "https://www.google.com/search?tbm=vid&q="
        + encodeURIComponent(query);

    }


    window.open(
        url,
        "_blank",
        "noopener,noreferrer"
    );
}


input.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Enter"){

            webSearch();

        }

    }
);

</script>

</body>
</html>


